


withCredentials block to access aws cli

withCredentials([usernamePassword(credentialsId: 'aws-cli', passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID')]) {
                  sh '''
                     # aws ec2 start-instances --instance-ids i-0520905212e116432
                     aws ec2 stop-instances --instance-ids i-0520905212e116432
                  '''
